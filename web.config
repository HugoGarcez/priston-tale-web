<?xml version="1.0" encoding="UTF-8"?>
<!-- Priston Tale in the browser - IIS settings for the site folder.
     data\web.config has the settings for the game data folder. -->
<configuration>
	<appSettings>
		<!-- ports of server.exe the bridge (ws.ashx) may connect to, on this computer -->
		<add key="PristonGamePorts" value="10007" />
	</appSettings>

	<system.web>
		<!-- ws.ashx is compiled by ASP.NET 4.x; WebSockets need the 4.5+ runtime behaviour -->
		<compilation targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
	</system.web>

	<system.webServer>
		<!-- the game uses threads (SharedArrayBuffer): browsers allow them only on pages
		     sent with these headers, and only over HTTPS -->
		<httpProtocol>
			<customHeaders>
				<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
				<add name="Cross-Origin-Resource-Policy" value="same-origin" />
			</customHeaders>
		</httpProtocol>

		<staticContent>
			<remove fileExtension=".wasm" />
			<mimeMap fileExtension=".wasm" mimeType="application/wasm" />
			<remove fileExtension=".pack" />
			<mimeMap fileExtension=".pack" mimeType="application/octet-stream" />
			<remove fileExtension=".txt" />
			<mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
			<!-- the page and program change with updates: browsers check for a newer copy -->
			<clientCache cacheControlMode="DisableCache" />
		</staticContent>

		<!-- never served: the git repository, and the source/build folder kept next to the site -->
		<security>
			<requestFiltering>
				<hiddenSegments>
					<add segment=".git" />
					<add segment="[project]" />
				</hiddenSegments>
			</requestFiltering>
		</security>

		<defaultDocument enabled="true">
			<files>
				<clear />
				<add value="index.html" />
			</files>
		</defaultDocument>
	</system.webServer>
</configuration>
