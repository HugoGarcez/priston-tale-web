# Site address: ":80" for plain HTTP (only http://localhost on the server itself can
# play then), or your domain name for HTTPS, e.g. PT_SITE=play.example.com
# (point the domain at this server and open ports 80 and 443 first).
PT_SITE=:80

# ports of server.exe the bridge may connect to (as PristonGamePorts in web.config)
PT_GAME_PORTS=10007
