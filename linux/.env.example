# Site address: ":80" for plain HTTP (only http://localhost on the server itself can
# play then), or your domain name for HTTPS, e.g. PT_SITE=play.example.com
# (point the domain at this server and open ports 80 and 443 first).
PT_SITE=:80

# ports of server.exe the bridge may connect to (as PristonGamePorts in web.config)
PT_GAME_PORTS=10007

# Who may connect to the site (default everyone). Behind Cloudflare, set its ranges
# (https://www.cloudflare.com/ips/) so the server's IP can't be used to skip it:
#PT_ALLOWED_IPS=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
