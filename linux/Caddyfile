# Caddy settings: the Linux replacement for IIS and web.config / data/web.config.
# PT_SITE is the address: ":80" for plain HTTP (playing on the server itself via
# http://localhost), or a domain name such as "play.example.com", for which Caddy
# gets and renews an HTTPS certificate by itself.
{$PT_SITE} {
	# the game uses threads (SharedArrayBuffer): browsers allow them only on pages
	# sent with these headers, and only over HTTPS (or http://localhost)
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy same-origin
	}

	# game data changes rarely; the page and program change with updates
	@data path /data/*
	header @data Cache-Control "public, max-age=604800"
	@notdata not path /data/*
	header @notdata Cache-Control "no-cache"

	@pack path *.pack
	header @pack Content-Type application/octet-stream

	# compress what browsers download: data_startup.pack 91 -> ~45 MB, game.wasm
	# 5 -> ~1.2 MB. Caddy's default list leaves out octet-stream (the pack, data files).
	# Without a Content-Length the loader shows "N MB" instead of a percentage.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type application/wasm
			header Content-Type application/octet-stream
		}
	}

	# never served: the git repository, dotfiles, the source/server folder and these
	# settings. A handle of its own, listed first: handle blocks run before a bare
	# respond would, and only the first matching handle runs.
	@hidden path_regexp hidden (?i)^/(\.|\[project\]|%5Bproject%5D|linux(/|$))
	handle @hidden {
		respond 404
	}

	# WebSocket bridge to server.exe (config.js serverUrl 'ws.ashx')
	handle /ws.ashx {
		reverse_proxy server:8081
	}

	handle {
		root * /srv/site
		file_server
	}
}
